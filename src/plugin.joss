func remove_background($opts) {
    $remover = new JossBgRemover()
    return $remover->process($opts)
}

func preload() {
    return {"status": "preloaded"}
}

class JossBgRemover {
    func ping() {
        return "pong desde joss_bg_remover"
    }

    func process($opts) {
        $params = (is_array($opts) && count($opts) > 0) ? $opts[0] : $opts
        $imagePath = $params["image_path"] ?? ""
        $outputPath = $params["output_path"] ?? ""

        return (!empty($imagePath) && file_exists($imagePath)) ? {
            $pluginDir = Plugin::path("joss_bg_remover", ".")
            $driverExe = $pluginDir . "/joss_bg_remover.exe"

            return (file_exists($driverExe)) ? {
                $proc = Process::start([$driverExe, "remove_background", $imagePath, $outputPath])
                $exitCode = Process::wait($proc)
                return {
                    "success": ($exitCode == 0),
                    "output_path": $outputPath,
                    "provider": "joss_bg_remover_onnx"
                }
            } : {
                $content = file_get_contents($imagePath)
                file_put_contents($outputPath, $content)
                return {
                    "success": true,
                    "output_path": $outputPath,
                    "provider": "joss_bg_remover_fallback"
                }
            }
        } : {
            return {"error": "Archivo de imagen no encontrado o inválido"}
        }
    }
}
